DATABASE_URL=postgresql+psycopg://crashlab:crashlab@localhost:5432/crashlab
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123456
S3_BUCKET=sepurux
S3_REGION=us-east-1

OPA_URL=http://localhost:8181
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional: protects /v1/ci/* routes when set
CI_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=
PR_NUMBER=
SUPER_ADMIN_EMAILS=
INTERNAL_ALERT_SLACK_WEBHOOK_URL=
INTERNAL_ALERT_SMTP_HOST=
INTERNAL_ALERT_SMTP_PORT=587
INTERNAL_ALERT_SMTP_USER=
INTERNAL_ALERT_SMTP_PASS=
INTERNAL_ALERT_SMTP_STARTTLS=true
INTERNAL_ALERT_EMAIL_FROM=
INTERNAL_ALERT_EMAIL_TO=

# Email notifications (provider: Resend)
EMAIL_PROVIDER=resend
EMAIL_FROM="Sepurux <no-reply@sepurux.com>"
EMAIL_REPLY_TO="support@sepurux.com"
EMAIL_RESEND_API_KEY=replace_with_resend_api_key
EMAIL_RESEND_API_BASE_URL=https://api.resend.com
SEPURUX_UI_BASE_URL=https://app.sepurux.com
SEPURUX_API_PUBLIC_URL=https://api.sepurux.com
SEPURUX_DOCS_URL=https://docs.sepurux.com
SEPURUX_EMAIL_LOGO_URL=https://sepurux.com/logo.png
SEPURUX_EMAIL_BRAND_COLOR=#22c55e
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Stripe (leave blank to disable self-serve checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_CURRENCY=usd
STRIPE_TOPUP_CENTS_PER_CREDIT=10

# Credits granted to new users on signup (0 to disable)
SIGNUP_CREDITS=100
