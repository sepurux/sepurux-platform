# ── Local dev environment for infra/docker-compose.yml ──────────────────────
# Copy this file to .env (in the repo root) and fill in the values you need.
# The infra/docker-compose.yml reads from this file automatically.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=crashlab
POSTGRES_PASSWORD=crashlab
POSTGRES_DB=crashlab

# ── API service ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://crashlab:crashlab@postgres:5432/crashlab
REDIS_URL=redis://redis:6379/0
S3_BUCKET=sepurux
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Leave blank to disable emails in local dev (API will log a warning and skip).
# Set these to send real emails from your local environment.
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_RESEND_API_KEY=
# Secret used to sign marketing unsubscribe tokens. Set to any random string.
EMAIL_UNSUBSCRIBE_SECRET=

# ── UI (Next.js) ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the browser bundle at build time.
# Do NOT set NEXT_PUBLIC_SEPURUX_API_KEY or NEXT_PUBLIC_PROJECT_ID to
# shared dev credentials — any value here ends up in the compiled JS.
# Leave them empty; users authenticate through the normal login flow.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SEPURUX_API_KEY=
NEXT_PUBLIC_PROJECT_ID=
