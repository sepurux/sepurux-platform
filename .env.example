# Docker Compose defaults (infra/docker-compose.yml)
POSTGRES_USER=crashlab
POSTGRES_PASSWORD=crashlab
POSTGRES_DB=crashlab

# API service
DATABASE_URL=postgresql+psycopg://crashlab:crashlab@postgres:5432/crashlab
REDIS_URL=redis://redis:6379/0
S3_BUCKET=sepurux
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
